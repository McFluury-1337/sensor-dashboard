API_KEY=changeme
API_URL=http://127.0.0.1:5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=changeme

# По умолчанию — sqlite (локальная разработка). На хостинге поставить mysql
# и заполнить остальные DB_* переменные данными из панели Beget.
DB_BACKEND=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=changeme
DB_USER=changeme
DB_PASSWORD=changeme

# Необязательно: уведомление в Telegram при переходе в «неисправность».
# Токен — у @BotFather (команда /newbot), chat_id — написать боту и открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates, взять id из ответа.
# Если оставить пустыми — уведомления просто не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: второй получатель (например, дежурный без доступа к
# админке) — получает короткое «Проверьте оборудование» без ссылки на
# /admin и без разбора по показаниям. Пусто — второе сообщение не шлётся.
TELEGRAM_CHAT_ID_STAFF=
